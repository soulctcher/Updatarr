# Copy this file to ~/.config/updatarr/updatarr.env and set a unique password.
# Keep that file readable only by your user: chmod 600 ~/.config/updatarr/updatarr.env
UPDATARR_PASSWORD=
UPDATARR_BIND_HOST=127.0.0.1
UPDATARR_PORT=8788
UPDATARR_PUBLIC_ORIGIN=http://127.0.0.1:8788
UPDATARR_ALLOWED_HOSTS=127.0.0.1,localhost
UPDATARR_PROVIDER_MODE=live

# Optional URL prefix, for example /updatarr.
# UPDATARR_URL_BASE=/updatarr

# For HTTPS terminated by a proxy on this same computer, keep the bind host on
# loopback, set the https public origin and exact allowed host above, then set:
# UPDATARR_REVERSE_PROXY=1

# Direct non-loopback listening requires both files and an https public origin.
# UPDATARR_TLS_CERTFILE=/path/to/fullchain.pem
# UPDATARR_TLS_KEYFILE=/path/to/private-key.pem
