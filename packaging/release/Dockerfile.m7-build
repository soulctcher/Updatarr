FROM archlinux:base-devel@sha256:cb06b309ab9424b354a8e1099a934fc48b13e62c3d4453d19d50beaa72c6caee

RUN pacman -Syu --noconfirm --needed \
      python \
      python-build \
      python-installer \
      python-setuptools \
      python-wheel \
    && pacman -Scc --noconfirm

RUN useradd --create-home --uid 1000 builder
WORKDIR /tmp/build

